# Copier ce fichier en .env puis l'adapter : cp .env.example .env
# Le mot de passe de la base n'est PAS ici : il est dans secrets/db_password.txt

# Nom de la base et utilisateur PostgreSQL
POSTGRES_DB=taskboard
POSTGRES_USER=taskboard

# Port publié par le front, sur 127.0.0.1 uniquement
FRONT_PORT=8080

# Version (tag) des images construites taskboard-api et taskboard-front
TASKBOARD_VERSION=1.0.0
